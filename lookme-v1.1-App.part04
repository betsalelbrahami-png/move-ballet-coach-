  addPanel:{flexDirection:'row',gap:10,marginBottom:12},quickAdd:{flex:1,backgroundColor:'#fff',borderWidth:1,borderColor:'#E8E1D8',borderRadius:22,padding:16,minHeight:132,justifyContent:'center'},quickEmoji:{fontSize:32,marginBottom:8},quickTitle:{fontSize:16,fontWeight:'900'},quickSub:{fontSize:12,color:'#888',marginTop:3},
  detected:{backgroundColor:'#111',borderRadius:20,padding:16,marginTop:12},detectedTitle:{fontSize:20,fontWeight:'900',color:'#fff'},detectedSub:{fontSize:13,color:'#D8D8D8',marginTop:4},reviewImage:{width:'100%',height:420,borderRadius:24,backgroundColor:'#EEE'},
  categoryWrap:{flexDirection:'row',flexWrap:'wrap',gap:8},categoryButton:{paddingHorizontal:13,paddingVertical:10,borderRadius:99,backgroundColor:'#fff',borderWidth:1,borderColor:'#E4DED5'},categoryButtonOn:{backgroundColor:'#111'},categoryText:{fontWeight:'750'},categoryTextOn:{fontWeight:'800',color:'#fff'},
  chip:{paddingHorizontal:13,paddingVertical:9,borderRadius:99,backgroundColor:'#fff',borderWidth:1,borderColor:'#E6DFD6',marginRight:7},chipOn:{backgroundColor:'#111'},chipText:{fontWeight:'700'},chipTextOn:{color:'#fff',fontWeight:'800'},
  grid:{flexDirection:'row',flexWrap:'wrap',gap:10},item:{width:'48%',backgroundColor:'#fff',borderWidth:1,borderColor:'#E8E1D8',borderRadius:22,overflow:'hidden',paddingBottom:11},selected:{borderWidth:3,borderColor:'#111'},itemImg:{width:'100%',height:190,backgroundColor:'#F2F0EC'},i