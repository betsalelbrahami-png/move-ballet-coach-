 invente ou déforme le vêtement.</Text>
        <View style={styles.lookBoard}>{selectedItems.map(item=><View key={item.id} style={styles.lookPiece}><Image source={{uri:item.localUri}} style={styles.lookImage} resizeMode="contain"/><Text style={styles.lookLabel}>{categoryLabel[item.category]}</Text></View>)}</View>
        <Button title="Sauvegarder ce look" disabled={busy||!selected.length} onPress={saveCurrentLook}/>
        <Button secondary title="Modifier" onPress={()=>setScreen('create')}/>
      </>}

      {screen === 'saved' && <>
        <Text style={styles.h1}>Mes looks</Text>
        {!savedLooks.length && <Text style={styles.p}>Aucun look sauvegardé pour l’instant.</Text>}
        {savedLooks.map(look=><Pressable key={look.id} style={styles.card} onPress={()=>{setSelected(look.itemIds.filter(id=>closet.some(x=>x.id===id)));setOccasion(look.occasion||'Quotidien');setScreen('look');}}>
          <Text style={styles.cardTitle}>{look.title}</Text><Text style={styles.pSmall}>{look.occasion || 'Look personnel'}</Text>
          <View style={styles.thumbRow}>{look.itemIds.map(id=>{const item=closet.find(x=>x.id===id);return item?<Image key={id} source={{uri:item.localUri}} style={styles.thumb}/>:null;})}</View>
        </Pressable>)}
      </>}
    </ScrollView>

    {(['closet','create','look','saved'] as Screen[]).includes(screen) && <View style={styles.nav}>
      <Nav label="Dressing" active={screen==='closet'} onPress={()=>setScreen('closet')}/>
      <Nav label="Créer" active={screen==='create'||screen==='look'} onPress={()=>setScreen('create')}/>
      <Nav label="Looks" active={screen==='saved'} onPress={()=>setScreen('saved')}/>
    </View>}
  </SafeAreaView>;
}

function Button({title,onPress,disabled,secondary,danger}:{title:string;onPress:()=>void;disabled?:boolean;secondary?:boolean;danger?:boolean}) {
  return <Pressable disabled={disabled} onPress={onPress} style={[styles.button,secondary&&styles.buttonSecondary,danger&&styles.buttonDanger,disabled&&{opacity:.45}]}><Text style={[styles.buttonText,secondary&&{color:'#111'}]}>{title}</Text></Pressable>;
}
function Nav({label,active,onPress}:{label:string;active:boolean;onPress:()=>void}) {
  return <Pressable onPress={onPress} style={[styles.navBtn,active&&styles.navOn]}><Text style={{fontWeight:'800',color:active?'#fff':'#333'}}>{label}</Text></Pressable>;
}

